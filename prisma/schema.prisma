generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// STUDENTS
// ==========================================

model Student {
  id        String   @id @default(cuid())
  code      String   @unique
  firstName String?
  lastName  String?
  grade     Int      @default(5)
  createdAt DateTime @default(now())

  assessmentResponses AssessmentResponse[]
  exitTickets         ExitTicket[]
  memberships         GroupMember[]
  attendances         Attendance[]
  sessions            StudentSession[]
}

// ==========================================
// LEARNING GROUPS
// ==========================================

model LearningGroup {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members             GroupMember[]
  assessmentResponses AssessmentResponse[]
}

model GroupMember {
  id        String @id @default(cuid())
  studentId String
  groupId   String

  student Student       @relation(fields: [studentId], references: [id])
  group   LearningGroup @relation(fields: [groupId], references: [id])

  @@unique([studentId, groupId])
}

// ==========================================
// EXIT TICKETS
// ==========================================

model ExitTicket {
  id            String   @id @default(cuid())
  studentId     String
  activityId    String
  questionText  String
  correctAnswer String
  studentAnswer String
  justification String
  isCorrect     Boolean
  createdAt     DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])
}

// ==========================================
// ACTIVITIES
// ==========================================

model Activity {
  id        String   @id @default(cuid())
  title     String
  grade     Int      @default(5)
  objective String
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  questions Question[]
  attempts  Attempt[]
}

model Question {
  id           String   @id @default(cuid())
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  position     Int
  title        String
  statement    String
  modelType    String   @default("PART_WHOLE")
  total        Int
  known        Int
  answer       Int
  totalLabel   String
  knownLabel   String
  unknownLabel String
  unit         String

  attempts Attempt[]

  @@unique([activityId, position])
}

model Attempt {
  id              String   @id @default(cuid())
  activityId      String
  activity        Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  learnerCode     String
  dataJson        String
  barJson         String
  equationJson    String
  answerText      String
  justification   String
  dataCorrect     Boolean
  modelCorrect    Boolean
  equationCorrect Boolean
  answerCorrect   Boolean
  createdAt       DateTime @default(now())
}

// ==========================================
// MATHEMATICAL SKILLS
// ==========================================

enum MathSkill {
  REPRESENTAR
  MODELAR
  RESOLVER_PROBLEMAS
  ARGUMENTAR_COMUNICAR
}

enum ReviewStatus {
  PENDING
  AUTO_GRADED
  TEACHER_REVIEWED
}

// ==========================================
// ASSESSMENT RESPONSES
// ==========================================

model AssessmentResponse {
  id            String       @id @default(cuid())
  submissionKey String       @unique
  activityKey   String
  questionKey   String
  skill         MathSkill
  studentId     String?
  groupId       String?
  answerJson    String
  points        Float?
  maxPoints     Float        @default(1)
  reviewStatus  ReviewStatus @default(PENDING)
  createdAt     DateTime     @default(now())

  student Student?       @relation(fields: [studentId], references: [id])
  group   LearningGroup? @relation(fields: [groupId], references: [id])

  @@index([activityKey, skill])
  @@index([studentId, createdAt])
  @@index([groupId, createdAt])
}

// ==========================================
// ATTENDANCE
// ==========================================

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  sessionId String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, sessionId])
  @@index([sessionId])
}

// ==========================================
// CLASSROOM CONTROL
// ==========================================

model ClassroomSetting {
  id        String   @id @default("main")
  isOpen    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model StudentSession {
  id        String   @id @default(cuid())
  studentId String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
