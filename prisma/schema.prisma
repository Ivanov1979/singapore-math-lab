
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Activity {
  id        String     @id @default(cuid())
  title     String
  grade     Int        @default(5)
  objective String
  published Boolean    @default(true)
  createdAt DateTime   @default(now())
  questions Question[]
  attempts  Attempt[]
}

model Question {
  id           String    @id @default(cuid())
  activityId   String
  activity     Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  position     Int
  title        String
  statement    String
  modelType    String    @default("PART_WHOLE")
  total        Int
  known        Int
  answer       Int
  totalLabel   String
  knownLabel   String
  unknownLabel String
  unit         String
  attempts     Attempt[]

  @@unique([activityId, position])
}

model Attempt {
  id            String   @id @default(cuid())
  activityId    String
  activity      Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  learnerCode   String
  dataJson      String
  barJson       String
  equationJson  String
  answerText    String
  justification String
  dataCorrect   Boolean
  modelCorrect  Boolean
  equationCorrect Boolean
  answerCorrect Boolean
  createdAt     DateTime @default(now())
}
